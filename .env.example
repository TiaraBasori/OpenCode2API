# Copy this file to .env before running docker compose.

API_KEY=change-me
OPENCODE_SERVER_PASSWORD=change-me-too

# Optional multi-user keys (comma-separated "name:key"; a bare key without a
# name is auto-named key-N). Requests matching any entry authenticate and are
# metered per name; everything else still falls back to API_KEY above.
# API_KEY doubles as the admin key for GET/POST/DELETE /admin/keys.
# OPENCODE_API_KEYS=alice:sk-alice-xxxx,bob:sk-bob-xxxx,sk-bare-key-xxxx

# Safer default. Keep true unless you really want model tool access.
OPENCODE_DISABLE_TOOLS=true
# Reuse one backend session per multi-turn chat conversation (appends only new
# turns so upstream prompt caches hit). Off by default.
OPENCODE_CHAT_SESSION_AFFINITY=false

# External tools from clients are virtualized by the proxy (namespace-isolated
# as external__*) and returned as standard tool_calls / function_call events.

# Helpful when running behind OpenClaw or other clients that already manage prompts:
# ignore the client system prompt and rely on the backend's own.
OPENCODE_PROXY_OMIT_SYSTEM_PROMPT=true

# Periodically clean proxy-owned conversation/session storage.
OPENCODE_PROXY_AUTO_CLEANUP_CONVERSATIONS=true
OPENCODE_PROXY_CLEANUP_INTERVAL_MS=43200000
OPENCODE_PROXY_CLEANUP_MAX_AGE_MS=86400000

# Optional overrides
# OPENCODE_PROXY_PORT=10000
# OPENCODE_SERVER_PORT=10001
# OPENCODE_USE_ISOLATED_HOME=false
# OPENCODE_PROXY_REQUEST_TIMEOUT_MS=180000
# OPENCODE_PROXY_DEBUG=false
# OPENCODE_ZEN_API_KEY=

# Built-in web panel at /panel (read-only status/models/usage/diagnostics
# view). Off by default; with API_KEY set, the panel asks for the key in the
# browser and never returns secret values.
# OPENCODE_WEB_PANEL_ENABLED=false
